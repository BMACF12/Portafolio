<button class="scroll-counter" data-scroll-counter type="button" aria-label="Scroll to top">
  <span data-scroll-percent>00</span><small>%</small>
</button>

<style>
  .scroll-counter { position: fixed; right: var(--gutter); top: 10rem; z-index: 40; display: flex; align-items: baseline; gap: .2rem; color: var(--color-accent); font: 500 1.2rem/1 var(--font-mono); letter-spacing: .1em; opacity: 0; transform: translateY(-12px); transition: opacity 400ms var(--ease-out-expo), transform 400ms var(--ease-out-expo); }
  .scroll-counter.is-visible { opacity: 1; transform: translateY(0); }
  .scroll-counter small { color: var(--color-text-muted); font-size: .9rem; }
  .scroll-counter:hover { color: var(--color-accent-hover); }
  @media (max-width: 700px) { .scroll-counter { top: calc(8rem + env(safe-area-inset-top, 0px)); right: max(2rem, env(safe-area-inset-right, 0px)); } }
</style>
