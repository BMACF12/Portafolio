<div class="page-loader" data-page-loader aria-hidden="true">
  <div class="page-loader-inner">
    <span class="page-loader-logo font-display">
      BF<span class="page-loader-dot">.</span>
    </span>
    <span class="page-loader-bar" aria-hidden="true"></span>
  </div>
</div>

<style is:inline>
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    background: #0a0a0a;
    background: var(--color-bg-primary, #0a0a0a);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 320ms ease, visibility 0s linear 320ms;
  }

  .page-loader.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .page-loader.is-done {
    opacity: 0;
    visibility: hidden;
  }

  .page-loader-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.8rem;
  }

  .page-loader-logo {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 3.4rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--color-text-primary, #fafafa);
  }

  .page-loader-dot {
    color: var(--color-accent, #e63946);
  }

  .page-loader-bar {
    display: block;
    width: 14rem;
    height: 2px;
    border-radius: 9999px;
    background: var(--color-border, #2a2a2a);
    overflow: hidden;
  }

  .page-loader-bar::after {
    content: "";
    display: block;
    width: 42%;
    height: 100%;
    border-radius: inherit;
    background: var(--color-accent, #e63946);
    box-shadow: 0 0 12px var(--color-accent-glow, rgba(230, 57, 70, 0.4));
    animation: page-loader-slide 1.1s cubic-bezier(0.87, 0, 0.13, 1) infinite;
  }

  @keyframes page-loader-slide {
    from { transform: translateX(-130%); }
    to { transform: translateX(360%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-loader {
      transition: none;
    }
    .page-loader-bar::after {
      width: 100%;
      animation: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const loader = document.querySelector("[data-page-loader]");
    if (!loader) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let shownAt = 0;
    let finished = false;

    const showTimer = window.setTimeout(function () {
      if (finished) return;
      shownAt = performance.now();
      loader.classList.add("is-visible");
      loader.setAttribute("aria-hidden", "false");
    }, 250);

    function finish() {
      if (finished) return;
      finished = true;
      window.clearTimeout(showTimer);

      const elapsed = shownAt ? performance.now() - shownAt : 0;
      const wait = shownAt ? Math.max(0, 500 - elapsed) : 0;

      window.setTimeout(function () {
        loader.classList.remove("is-visible");
        loader.classList.add("is-done");
        window.__bfLoaderDone = true;
        window.setTimeout(function () {
          loader.remove();
        }, reduceMotion ? 0 : 400);
      }, wait);
    }

    window.addEventListener(
      "load",
      function () {
        if (!shownAt) {
          finished = true;
          window.clearTimeout(showTimer);
          loader.remove();
          window.__bfLoaderDone = true;
          return;
        }
        finish();
      },
      { once: true }
    );

    window.setTimeout(function () {
      if (finished) return;
      if (!shownAt) {
        loader.remove();
        window.__bfLoaderDone = true;
        return;
      }
      finish();
    }, 2200);

    document.addEventListener("astro:page-load", function () {
      if (!window.__bfLoaderDone) return;
      document.querySelectorAll("[data-page-loader]").forEach(function (el) {
        el.remove();
      });
    });
  })();
</script>
