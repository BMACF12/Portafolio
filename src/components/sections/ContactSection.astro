---
import { type Locale, useTranslations } from '../../utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="contact-section" id="contact" data-section="contact">
  <div class="contact-bg" aria-hidden="true">
    <div class="contact-glow"></div>
  </div>

  <div
    class="container contact-container"
    data-msg-name-required={t.contact.validation.nameRequired}
    data-msg-email-required={t.contact.validation.emailRequired}
    data-msg-email-invalid={t.contact.validation.emailInvalid}
    data-msg-message-required={t.contact.validation.messageRequired}
    data-msg-message-min={t.contact.validation.messageMin}
    data-msg-success={t.contact.success}
    data-msg-error={t.contact.error}
  >
    <div class="contact-info">
      <div class="contact-info-inner reveal">
        <span class="contact-tag">{t.contact.label}</span>
        <h2 class="contact-title font-display">{t.contact.title}</h2>
        <p class="contact-desc">{t.contact.subtitle}</p>

        <div class="contact-cards">
          <a href="mailto:brianf13@outlook.es" class="contact-card magnetic">
            <div class="contact-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="contact-card-content">
              <span class="contact-card-label">{t.contact.info.email}</span>
              <span class="contact-card-value">brianf13@outlook.es</span>
            </div>
          </a>

          <div class="contact-card">
            <div class="contact-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="contact-card-content">
              <span class="contact-card-label">{t.contact.info.location}</span>
              <span class="contact-card-value">{t.contact.info.locationValue}</span>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12,6 12,12 16,14"></polyline>
              </svg>
            </div>
            <div class="contact-card-content">
              <span class="contact-card-label">{t.contact.info.availability}</span>
              <span class="contact-card-value">
                <span class="status-pill">
                  <span class="status-dot"></span>
                  {locale === 'es' ? 'Abierto a oportunidades' : 'Open to opportunities'}
                </span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <form class="contact-form reveal" id="contact-form" novalidate data-form-mount>
      <div class="form-row">
        <div class="form-group">
          <label for="name">{t.contact.name} *</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            placeholder="John Doe"
          />
          <span class="form-error" data-error="name"></span>
        </div>
        <div class="form-group">
          <label for="email">{t.contact.email} *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="john@example.com"
          />
          <span class="form-error" data-error="email"></span>
        </div>
      </div>

      <div class="form-group">
        <label for="subject">{t.contact.subject}</label>
        <input type="text" id="subject" name="subject" placeholder="..." />
      </div>

      <div class="form-group">
        <label for="message">{t.contact.message} *</label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          placeholder="..."
        ></textarea>
        <span class="form-error" data-error="message"></span>
      </div>

      <input type="text" name="bot-field" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <button type="submit" class="form-submit magnetic">
        <span class="submit-text">{t.contact.send}</span>
        <span class="submit-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"></path>
          </svg>
        </span>
        <span class="submit-loader" aria-hidden="true"></span>
      </button>

      <div class="form-status" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

<script>
  import '../../scripts/contact-form.client.ts';
</script>

<style>
  .contact-section {
    position: relative;
    padding: var(--section-spacing) 0;
    overflow: hidden;
  }

  .contact-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .contact-glow {
    position: absolute;
    top: -20%;
    left: -20%;
    width: 70%;
    height: 140%;
    background: radial-gradient(circle, var(--color-accent-glow), transparent 60%);
    filter: blur(140px);
    opacity: 0.25;
  }

  .contact-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .contact-container {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .contact-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
    padding: 0.4rem 1.2rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-full);
  }

  .contact-title {
    font-size: var(--text-display-3);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
  }

  .contact-desc {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-5);
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  a.contact-card:hover {
    border-color: var(--color-accent);
    transform: translateX(4px);
  }

  .contact-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.8rem;
    height: 4.8rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-tertiary);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .contact-card-icon svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  .contact-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contact-card-label {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
  }

  .contact-card-value {
    font-size: 1.5rem;
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: #4ade80;
  }

  .status-pill .status-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px #4ade80;
    animation: pulse 2s ease-in-out infinite;
  }

  /* Form */
  .contact-form {
    background: var(--color-bg-secondary);
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .form-group label {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-secondary);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1.4rem 1.6rem;
    background: var(--color-bg-tertiary);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: 1.4rem;
    transition: all var(--transition-base);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    background: var(--color-bg-elevated);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 12rem;
    line-height: 1.5;
  }

  .form-error {
    font-size: 1.2rem;
    color: #ff6b6b;
    min-height: 1.6rem;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.4rem 2.4rem;
    background: var(--color-accent);
    color: var(--color-text-inverse);
    border-radius: var(--radius-full);
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-base);
    box-shadow: var(--shadow-glow);
    margin-top: var(--space-2);
  }

  .form-submit:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow-lg);
  }

  .form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .submit-icon svg {
    width: 1.8rem;
    height: 1.8rem;
    transition: transform var(--transition-base);
  }

  .form-submit:hover .submit-icon svg {
    transform: translate(2px, -2px);
  }

  .submit-loader {
    display: none;
    width: 1.8rem;
    height: 1.8rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .form-submit.loading .submit-text,
  .form-submit.loading .submit-icon {
    display: none;
  }
  .form-submit.loading .submit-loader {
    display: block;
  }

  .form-status {
    padding: 1rem;
    border-radius: var(--radius-md);
    text-align: center;
    font-size: 1.3rem;
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .form-status.success {
    background: rgba(74, 222, 128, 0.1);
    color: #4ade80;
  }
  .form-status.error {
    background: rgba(255, 107, 107, 0.1);
    color: #ff6b6b;
  }
</style>
