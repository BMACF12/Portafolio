---
import { type Locale, useTranslations } from '../../utils/i18n';
import SectionLabel from '../ui/SectionLabel.astro';
import CodeEditor from '../ui/CodeEditor.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="intro" id="intro" data-section="intro" data-sticky-section>
  <div class="intro-sticky" data-sticky-inner>
    <div class="container intro-container">
      <div class="intro-text">
        <SectionLabel label={t.intro.label} number="01" />

        <h2 class="intro-title font-display">
          <span class="intro-line reveal">{t.intro.title}</span>
          <span class="intro-line reveal intro-line-accent">{t.intro.titleAccent}</span>
        </h2>

        <div class="intro-paragraphs">
          {t.intro.paragraphs.map((p) => (
            <p class="intro-paragraph reveal">{p}</p>
          ))}
        </div>
      </div>

      <div class="intro-visual">
        <CodeEditor locale={locale} />
        <div class="intro-stats">
          <div class="stat">
            <span class="stat-value">3+</span>
            <span class="stat-label">{locale === 'es' ? 'Años' : 'Years'}</span>
          </div>
          <div class="stat">
            <span class="stat-value">10+</span>
            <span class="stat-label">{locale === 'es' ? 'Proyectos' : 'Projects'}</span>
          </div>
          <div class="stat">
            <span class="stat-value">5+</span>
            <span class="stat-label">{locale === 'es' ? 'Tecnologías' : 'Techs'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .intro {
    position: relative;
    min-height: 200vh;
  }

  .intro-sticky {
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .intro-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .intro-container {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .intro-title {
    font-size: var(--text-display-2);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-6);
  }

  .intro-line {
    display: block;
  }

  .intro-line-accent {
    color: var(--color-accent);
  }

  .intro-paragraphs {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .intro-paragraph {
    font-size: var(--text-body-lg);
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 55ch;
  }

  .intro-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .intro-stats {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-bg-tertiary) 60%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 5.5rem;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-muted);
    margin-top: 0.4rem;
  }
</style>
