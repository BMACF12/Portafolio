---
import { type Locale, useTranslations } from '../../utils/i18n';
import SectionLabel from '../ui/SectionLabel.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="experience" id="experience" data-section="experience">
  <div class="container">
    <div class="exp-header">
      <SectionLabel label={t.nav.experience} number="06" />
      <h2 class="exp-title font-display reveal">{locale === 'es' ? 'Mi viaje' : 'My journey'}</h2>
    </div>

    <ol class="timeline" role="list">
      <li class="timeline-item reveal">
        <div class="timeline-marker">
          <span class="timeline-dot"></span>
          <span class="timeline-line"></span>
        </div>
        <div class="timeline-content">
          <span class="timeline-date">{locale === 'es' ? '2026 — 2027 · 8 meses' : '2026 — 2027 · 8 months'}</span>
          <h3 class="timeline-title font-display">{locale === 'es' ? 'Desarrollador y Soporte de CRM' : 'CRM Developer & Support'}</h3>
          <p class="timeline-place">Eclipttica · Marketing Digital</p>
          <p class="timeline-desc">
            {locale === 'es'
              ? 'Desarrollo y soporte del CRM propio de la empresa, construido en TypeScript e integrado con las APIs de Meta y WhatsApp. Implementé funcionalidades de IA con RAG para el equipo comercial y atendí incidencias en producción.'
              : "Development and support of the company's in-house CRM, built in TypeScript and integrated with Meta and WhatsApp APIs. I implemented AI features with RAG for the sales team and handled production incidents."}
          </p>
        </div>
      </li>

      <li class="timeline-item reveal">
        <div class="timeline-marker">
          <span class="timeline-dot"></span>
          <span class="timeline-line"></span>
        </div>
        <div class="timeline-content">
          <span class="timeline-date">2026</span>
          <h3 class="timeline-title font-display">{locale === 'es' ? 'Proyecto de Tesis · Auditor IA' : 'Thesis Project · Auditor IA'}</h3>
          <p class="timeline-place">Universidad de las Fuerzas Armadas ESPE</p>
          <p class="timeline-desc">
            {locale === 'es'
              ? 'Diseñé y desarrollé un sistema RAG que audita evidencias de acreditación universitaria: extracción determinista de PDFs, recuperación normativa en ChromaDB y dictamen con LLM, sobre una cola asíncrona con Celery y Redis.'
              : 'I designed and built a RAG system that audits university accreditation evidence: deterministic PDF extraction, regulation retrieval in ChromaDB and LLM assessment, running on an async Celery + Redis queue.'}
          </p>
        </div>
      </li>

      <li class="timeline-item reveal">
        <div class="timeline-marker">
          <span class="timeline-dot"></span>
          <span class="timeline-line"></span>
        </div>
        <div class="timeline-content">
          <span class="timeline-date">2025 — 2026</span>
          <h3 class="timeline-title font-display">{locale === 'es' ? 'Desarrollador Front-End & Diseñador' : 'Front-End Developer & Designer'}</h3>
          <p class="timeline-place">AYRE Centro de Desarrollo Integral</p>
          <p class="timeline-desc">
            {locale === 'es'
              ? 'Desarrollo frontend de aplicaciones web responsivas con JavaScript y TypeScript, complementado con el diseño de la identidad visual del negocio.'
              : 'Frontend development of responsive web applications with JavaScript and TypeScript, complemented by the design of the business visual identity.'}
          </p>
        </div>
      </li>

      <li class="timeline-item reveal">
        <div class="timeline-marker">
          <span class="timeline-dot"></span>
          <span class="timeline-line"></span>
        </div>
        <div class="timeline-content">
          <span class="timeline-date">2024 — 2025</span>
          <h3 class="timeline-title font-display">{locale === 'es' ? 'Prácticas Pre-Profesionales en Desarrollo de Software' : 'Software Development Internship'}</h3>
          <p class="timeline-place">DIRMOV</p>
          <p class="timeline-desc">
            {locale === 'es'
              ? 'Participación en el desarrollo e implementación de proyectos de software y en la elaboración de documentación técnica, cuidando el ciclo de vida del desarrollo y la escalabilidad de los sistemas.'
              : 'Involvement in the development and implementation of software projects and in the creation of technical documentation, supporting the development lifecycle and system scalability.'}
          </p>
        </div>
      </li>

      <li class="timeline-item reveal">
        <div class="timeline-marker">
          <span class="timeline-dot"></span>
          <span class="timeline-line"></span>
        </div>
        <div class="timeline-content">
          <span class="timeline-date">2022</span>
          <h3 class="timeline-title font-display">{locale === 'es' ? 'Primeros pasos en código' : 'First steps in code'}</h3>
          <p class="timeline-place">{locale === 'es' ? 'Autodidacta · Ecuador' : 'Self-taught · Ecuador'}</p>
          <p class="timeline-desc">
            {locale === 'es'
              ? 'Descubrí la programación y comencé a construir proyectos propios: calculadoras, sitios web estáticos, pequeños bots. Ese fue el inicio del camino.'
              : 'I discovered programming and started building personal projects: calculators, static websites, small bots. That was the beginning of the journey.'}
          </p>
        </div>
      </li>

      <li class="timeline-item reveal">
        <div class="timeline-marker">
          <span class="timeline-dot"></span>
          <span class="timeline-line"></span>
        </div>
        <div class="timeline-content">
          <span class="timeline-date">2021 — {locale === 'es' ? 'Actualidad' : 'Present'}</span>
          <h3 class="timeline-title font-display">{locale === 'es' ? 'Estudiante de Ingeniería en Software' : 'Software Engineering Student'}</h3>
          <p class="timeline-place">Universidad de las Fuerzas Armadas ESPE · Ecuador</p>
          <p class="timeline-desc">
            {locale === 'es'
              ? 'Formación en arquitecturas de software, bases de datos y automatización de procesos, con enfoque en ecosistemas de IA, arquitecturas RAG y consumo de APIs. Proyectos académicos y personales con Angular, Flutter y TypeScript.'
              : 'Education in software architectures, databases and process automation, focused on AI ecosystems, RAG architectures and API integration. Academic and personal projects with Angular, Flutter and TypeScript.'}
          </p>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .experience {
    padding: var(--section-spacing) 0;
    background: var(--color-bg-secondary);
    position: relative;
  }

  .exp-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .exp-title {
    font-size: var(--text-display-3);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .timeline {
    list-style: none;
    max-width: 80rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    padding-top: 1rem;
  }

  .timeline-dot {
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent-glow);
    flex-shrink: 0;
  }

  .timeline-line {
    width: 2px;
    flex-grow: 1;
    background: var(--color-border);
    margin-top: 1rem;
    min-height: 8rem;
  }

  .timeline-item:last-child .timeline-line {
    display: none;
  }

  .timeline-content {
    padding-bottom: var(--space-2);
  }

  .timeline-date {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--color-accent);
    margin-bottom: 0.8rem;
  }

  .timeline-title {
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .timeline-place {
    font-size: 1.4rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .timeline-desc {
    font-size: 1.5rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
