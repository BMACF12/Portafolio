---
import { Image } from 'astro:assets';
import profileImg from '../../assets/images/profile.jpg';
import { type Locale, useTranslations } from '../../utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const baseUrl = locale === 'en' ? '/en' : '';
---

<section class="hero" id="home" data-section="home" aria-label={t.nav.home}>
  <div class="hero-bg">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-1" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-2" aria-hidden="true"></div>
  </div>

  <div class="hero-container container">
    <div class="hero-content">
      <div class="hero-greeting reveal">
        <span class="hero-line"></span>
        <span class="hero-label">{t.hero.greeting}</span>
      </div>

      <h1 class="hero-name font-display">
        <span class="hero-text-line">
          <span class="hero-text-inner reveal" data-split-text>{t.hero.name}</span>
        </span>
      </h1>

      <div class="hero-role font-display reveal">
        <span class="hero-role-static">{t.hero.tagline}</span>
        <span class="hero-role-divider">·</span>
        <span class="hero-role-typing" data-typing-text></span>
        <span class="hero-role-cursor" aria-hidden="true">|</span>
      </div>

      <p class="hero-desc reveal">{t.hero.description}</p>

      <div class="hero-actions reveal-stagger">
        <a
          href={`${baseUrl}#projects`}
          class="btn-hero btn-primary magnetic"
          data-parallax-trigger
        >
          <span>{t.hero.cta.primary}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href={`${baseUrl}#contact`}
          class="btn-hero btn-ghost magnetic"
          data-parallax-trigger
        >
          <span>{t.hero.cta.secondary}</span>
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-image-wrap reveal" data-parallax="0.15">
        <div class="hero-image-frame">
          <Image
            src={profileImg}
            alt={`${t.hero.name} — ${t.hero.tagline}`}
            width={500}
            height={500}
            widths={[320, 500, 800]}
            sizes="(max-width: 768px) 70vw, 480px"
            format="webp"
            quality={85}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="hero-image-badge hero-badge-1">
          <span class="badge-dot"></span>
          <span>Angular · TS</span>
        </div>
        <div class="hero-image-badge hero-badge-2">
          <span class="badge-dot"></span>
          <span>Flutter</span>
        </div>
        <div class="hero-image-badge hero-badge-3">
          <span class="badge-dot"></span>
          <span>Available</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-scroll-indicator" aria-hidden="true">
    <span class="scroll-text">{t.hero.scrollIndicator}</span>
    <div class="scroll-arrow">
      <span></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-height) + 2rem);
    padding-bottom: var(--space-8);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero-grid {
    position: absolute;
    inset: -10%;
    background-image:
      linear-gradient(rgba(230, 57, 70, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(230, 57, 70, 0.05) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
  }
  .hero-glow-1 {
    top: 10%;
    left: -10%;
    width: 50rem;
    height: 50rem;
    background: var(--color-accent);
    opacity: 0.15;
  }
  .hero-glow-2 {
    bottom: -10%;
    right: -10%;
    width: 60rem;
    height: 60rem;
    background: var(--color-accent);
    opacity: 0.12;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .hero-content {
    max-width: 70rem;
  }

  .hero-greeting {
    display: inline-flex;
    align-items: center;
    gap: 1.4rem;
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: 1.4rem;
    color: var(--color-accent);
  }

  .hero-line {
    display: inline-block;
    width: 6rem;
    height: 1px;
    background: var(--color-accent);
  }

  .hero-label {
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .hero-name {
    font-size: var(--text-display-1);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    overflow: hidden;
  }

  .hero-text-line {
    display: block;
    overflow: hidden;
  }

  .hero-text-inner {
    display: inline-block;
  }

  .hero-role {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-size: var(--text-h3);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
    font-weight: 500;
    flex-wrap: wrap;
  }

  .hero-role-static {
    color: var(--color-text-secondary);
  }

  .hero-role-divider {
    color: var(--color-accent);
  }

  .hero-role-typing {
    color: var(--color-accent);
    font-weight: 600;
  }

  .hero-role-cursor {
    color: var(--color-accent);
    animation: blink 1s steps(1) infinite;
    font-weight: 100;
  }

  .hero-desc {
    font-size: var(--text-body-lg);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 55ch;
    margin-bottom: var(--space-7);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .btn-hero {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1.6rem 3rem;
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-glow);
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow-lg);
  }

  .btn-primary svg {
    width: 2rem;
    height: 2rem;
    transition: transform var(--transition-base);
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-text-primary);
    border: 1.5px solid var(--color-border);
  }

  .btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Visual */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    aspect-ratio: 1;
  }

  .hero-image-wrap {
    position: relative;
    width: clamp(280px, 40vw, 480px);
    aspect-ratio: 1;
  }

  .hero-image-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: var(--color-bg-secondary);
    box-shadow: var(--shadow-lg), var(--shadow-glow);
    transform: rotate(-2deg);
    transition: transform var(--transition-slow);
  }

  .hero-image-wrap:hover .hero-image-frame {
    transform: rotate(0deg) scale(1.02);
  }

  .hero-image-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(230, 57, 70, 0.15),
      transparent 60%
    );
    z-index: 1;
  }

  .hero-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-image-badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.4rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: var(--color-text-secondary);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: var(--shadow-md);
    z-index: 2;
  }

  .badge-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px #4ade80;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .hero-badge-1 {
    top: 5%;
    left: -10%;
    animation: float 6s ease-in-out infinite;
  }

  .hero-badge-2 {
    top: 50%;
    right: -15%;
    animation: float 6s ease-in-out infinite 2s;
  }

  .hero-badge-3 {
    bottom: 8%;
    left: -8%;
    animation: float 6s ease-in-out infinite 4s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 4rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--color-text-muted);
  }

  .scroll-arrow {
    width: 2rem;
    height: 3rem;
    border: 1.5px solid var(--color-text-muted);
    border-radius: 1rem;
    position: relative;
  }

  .scroll-arrow span {
    display: block;
    width: 2px;
    height: 6px;
    background: var(--color-accent);
    margin: 0.6rem auto;
    animation: scroll-indicator 1.6s ease-in-out infinite;
  }
</style>
