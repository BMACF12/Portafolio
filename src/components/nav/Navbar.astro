---
import { type Locale, useTranslations } from '../../utils/i18n';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = useTranslations(locale);

const pathWithoutLocale = currentPath.replace(/^\/(en)/, '') || '/';

const navLinks = [
  { href: `/${pathWithoutLocale === '/' ? '' : pathWithoutLocale}#home`, label: t.nav.home, id: 'home' },
  { href: `/${pathWithoutLocale === '/' ? '' : pathWithoutLocale}#intro`, label: t.nav.services, id: 'services' },
  { href: `/${pathWithoutLocale === '/' ? '' : pathWithoutLocale}#skills`, label: t.nav.skills, id: 'skills' },
  { href: `/${pathWithoutLocale === '/' ? '' : pathWithoutLocale}#projects`, label: t.nav.projects, id: 'projects' },
  { href: `/${pathWithoutLocale === '/' ? '' : pathWithoutLocale}#contact`, label: t.nav.contact, id: 'contact' },
];
---

<header class="navbar" data-navbar>
  <a href={currentPath} class="logo magnetic" aria-label={t.meta.author}>
    <span class="logo-mark" aria-hidden="true">BF</span>
    <span class="logo-text">brian<span class="dot">.</span>dev</span>
  </a>

  <nav class="nav-desktop" aria-label="Primary navigation">
    <ul role="list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="nav-link">{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="nav-actions">
    <a
      href="/cv/Brian_Flores_CV.pdf"
      class="cta-cv magnetic"
      download
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"></path>
      </svg>
      <span>{t.nav.cv}</span>
    </a>
    <LanguageSelector locale={locale} currentPath={currentPath} />
    <ThemeToggle locale={locale} />
  </div>

  <button
    class="menu-toggle magnetic"
    type="button"
    aria-controls="mobile-menu"
    aria-expanded="false"
    aria-label={t.nav.openMenu}
  >
    <span class="menu-line"></span>
    <span class="menu-line"></span>
    <span class="menu-line"></span>
  </button>

  <div id="mobile-menu" class="nav-mobile" aria-hidden="true" inert>
    <nav aria-label="Mobile navigation">
      <ul role="list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link-mobile">{link.label}</a>
          </li>
        ))}
        <li>
          <a
            href="/cv/Brian_Flores_CV.pdf"
            class="nav-link-mobile cta"
            download
          >
            {t.nav.cv}
          </a>
        </li>
      </ul>
      <div class="mobile-actions">
        <LanguageSelector locale={locale} currentPath={currentPath} />
        <ThemeToggle locale={locale} />
      </div>
    </nav>
  </div>
</header>

<style>
  .navbar {
    --nav-pad-y: 2rem;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding:
      calc(var(--nav-pad-y) + env(safe-area-inset-top, 0px))
      max(var(--gutter), env(safe-area-inset-right, 0px))
      var(--nav-pad-y)
      max(var(--gutter), env(safe-area-inset-left, 0px));
    border-bottom: 1px solid transparent;
    transition:
      padding var(--transition-base),
      border-color var(--transition-base);
    pointer-events: none;
  }

  .navbar::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: calc(100% + 5rem);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-bg-primary) 94%, transparent) 0%,
      color-mix(in srgb, var(--color-bg-primary) 78%, transparent) 45%,
      transparent 100%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-base);
  }

  .navbar.scrolled::before {
    opacity: 1;
  }

  .navbar > * {
    pointer-events: auto;
  }

  .navbar.scrolled {
    --nav-pad-y: 1.4rem;
    border-bottom-color: var(--color-border);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    letter-spacing: -0.02em;
  }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-size: 1.5rem;
    font-weight: 800;
    transition: transform var(--transition-base);
  }

  .logo:hover .logo-mark {
    transform: rotate(-8deg) scale(1.05);
  }

  .logo-text {
    color: var(--color-text-primary);
  }

  .dot {
    color: var(--color-accent);
  }

  .nav-desktop {
    display: none;
  }

  .nav-desktop ul {
    display: flex;
    gap: 3rem;
    list-style: none;
  }

  .nav-link {
    position: relative;
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    padding: 0.5rem 0;
    transition: color var(--transition-base);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width var(--transition-base);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text-primary);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-actions {
    display: none;
    align-items: center;
    gap: 1rem;
  }

  .cta-cv {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.8rem;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-accent);
    border: 1.5px solid var(--color-accent);
    font-size: 1.3rem;
    font-weight: 600;
    transition: all var(--transition-base);
  }

  .cta-cv svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .cta-cv:hover {
    background: var(--color-accent);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-glow);
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 4.2rem;
    height: 4.2rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
  }

  .menu-line {
    width: 1.8rem;
    height: 2px;
    background: var(--color-accent);
    border-radius: 2px;
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  .menu-toggle.active .menu-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle.active .menu-line:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.active .menu-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-mobile {
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
    background: var(--color-bg-primary);
    z-index: 99;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding:
      calc(var(--header-height) + env(safe-area-inset-top, 0px))
      0
      env(safe-area-inset-bottom, 0px);
    transform: translateX(100%);
    transition: transform 0.6s var(--ease-out-expo);
  }

  .nav-mobile.open {
    transform: translateX(0);
  }

  .nav-mobile nav {
    width: 100%;
    margin-block: auto;
    padding: var(--gutter);
  }

  .nav-mobile ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    text-align: center;
    margin-bottom: 4rem;
  }

  .nav-link-mobile {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 8vw, 4rem);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    transition: color var(--transition-base);
  }

  .nav-link-mobile:hover {
    color: var(--color-accent);
  }

  .nav-link-mobile.cta {
    color: var(--color-accent);
    font-size: 2rem;
  }

  .mobile-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  @media (max-width: 1023px) and (max-height: 700px) {
    .nav-mobile ul {
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .nav-link-mobile {
      font-size: clamp(2rem, 7vw, 3rem);
    }
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: block;
    }
    .nav-actions {
      display: flex;
    }
    .menu-toggle,
    .nav-mobile {
      display: none;
    }
  }
</style>
