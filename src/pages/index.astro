---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import StickyIntro from '../components/sections/StickyIntro.astro';
import Services from '../components/sections/Services.astro';
import Skills from '../components/sections/Skills.astro';
import ProjectsSlider from '../components/sections/ProjectsSlider.astro';
import Philosophy from '../components/sections/Philosophy.astro';
import Experience from '../components/sections/Experience.astro';
import ContactSection from '../components/sections/ContactSection.astro';

export const prerender = true;
---

<BaseLayout
  locale="es"
  title="Inicio"
  description="Ingeniero de Software especializado en Angular, TypeScript y Flutter. Construyo experiencias digitales modernas y de alto rendimiento."
>
  <Hero locale="es" />
  <StickyIntro locale="es" />
  <Services locale="es" />
  <Skills locale="es" />
  <ProjectsSlider locale="es" />
  <Philosophy locale="es" />
  <Experience locale="es" />
  <ContactSection locale="es" />
</BaseLayout>
