  <StickyIntro locale="en" />
  <Services locale="en" />
  <Skills locale="en" />
  <ProjectsSlider locale="en" />
  <Philosophy locale="en" />
  <Experience locale="en" />
  <ContactSection locale="en" />
</BaseLayout>
